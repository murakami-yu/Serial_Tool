<Window x:Class="SerialTool.App.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:SerialTool.App.Services"
        xmlns:ctrl="clr-namespace:SerialTool.App.Controls"
        Title="外观设置" SizeToContent="WidthAndHeight"
        Background="{Binding Source={x:Static s:Appearance.Instance}, Path=MainBgHex, Converter={StaticResource HexToBrush}}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <!-- 外观集中设置：ColorChipButton 双向绑定 Appearance 单例（改色即时生效，
         MainViewModel 订阅单例变化即落盘 ui_settings.json）；每项弹层内自带「恢复默认」+ 自定义色输入（HEX/RGB）。
         排版：单 Grid 双列，按钮全部拉伸到列宽（尺寸一致、左右两列逐行对齐），
         ShowHex 在按钮右端显示当前色值；说明文字收进左列尾部空位，整窗呈矩形无外凸。 -->
    <StackPanel Margin="16" Width="484">
        <!-- 预设行：与标题同行横排，省一行高度 -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="主题预设：" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <ComboBox x:Name="PresetCombo" Width="170" Margin="8,0,0,0" VerticalAlignment="Center"
                      ToolTip="一键整套应用全部颜色；单项微调后自动显示「自定义」"
                      SelectionChanged="PresetCombo_SelectionChanged"/>
            <TextBlock Text="（预设整套应用，可再单项微调）" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 界面字体行：字体族下拉 + 字号下拉；SelectedValue 双向绑 Appearance 单例
             （空串哨兵项 = 「跟随系统/默认」），选择即应用级联并落盘，与改色同链路。
             字体名统一用系统消息字体渲染（曾试过逐项用自身字体渲染 = 所见即所得，实测符号字体
             如 Bookshelf Symbol 07 的字母被映射成符号图形、名字成乱码，故弃）；
             整框钉死 MessageFontFamily——用户已选符号字体时列表仍可读，能选回来。
             行尾不放说明文字（窗口内容定宽 484，横向超宽会被裁切），说明收进 ToolTip。
             系统字体项数百个，显式虚拟化面板防下拉卡顿 -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="界面字体：" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <ComboBox x:Name="FontCombo" Width="260" Margin="8,0,0,0" VerticalAlignment="Center"
                      FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                      SelectedValue="{Binding Source={x:Static s:Appearance.Instance}, Path=UiFontFamily}"
                      ToolTip="全部界面文字的字体族（即时生效、自动保存）；含 Webdings 等符号字体——选中后界面会整体乱码，选回「（跟随系统）」即可恢复；数据区建议等宽字体，非等宽会导致列错位">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 空串哨兵项显示「（跟随系统）」，其余项显示字体名（系统消息字体，非该字体自渲染） -->
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="">
                                            <Setter Property="Text" Value="（跟随系统）"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="FontSizeCombo" Width="78" Margin="8,0,0,0" VerticalAlignment="Center"
                      SelectedValue="{Binding Source={x:Static s:Appearance.Instance}, Path=UiFontSize}"
                      ToolTip="全部界面文字字号（px）；「默认」= 界面 12px / 终端 14px">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="">
                                            <Setter Property="Text" Value="默认"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- 两列等宽：左=各界面背景色（5 项，行 1-5），右=控件颜色（8 项，行 1-8），
             同一 Grid 的行高共享保证两列逐行对齐；按钮 VerticalAlignment=Top 防行高波动时被拉伸变形 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 组标题：粗体 + 细分隔线，划清两个色区 -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="各界面背景色" FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}"/>
                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="控件颜色（全局）" FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}"/>
                <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 左列：各界面背景色 -->
            <ctrl:ColorChipButton Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,8,0,0"
                                  ShowHex="True" Label="主窗口（含对话框）"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=MainBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="主窗口背景色；SSH/Telnet/自定义波特率等对话框跟随此色"/>
            <ctrl:ColorChipButton Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="终端窗口"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=TerminalBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="终端窗口的框架背景（工具条/标签区，非终端内容）"/>
            <ctrl:ColorChipButton Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="波形窗口"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=ChartBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="图表（时序/字段曲线）窗口背景"/>
            <ctrl:ColorChipButton Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="模板编辑器"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=TemplateBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="协议模板编辑器窗口背景"/>
            <ctrl:ColorChipButton Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="终端内容底色"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=TermContentBgHex}"
                                  DefaultHex="#1E1E1E"
                                  ToolTip="终端字符区的背景色（已打开的标签页同步生效；ANSI 调色板不变）"/>

            <!-- 左列尾部空位（行 6-8）：说明文字，与右列底边基本齐平 -->
            <TextBlock Grid.Row="6" Grid.RowSpan="3" Grid.Column="0" Margin="0,12,0,0"
                       VerticalAlignment="Top" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="改色即时生效并自动保存；边框色自动派生控件边框（加深）与分隔线（调亮）。面板改深色时请自行搭配文字色；终端内容换浅色时默认文字色（浅灰）不变，建议终端底色选深色。"/>

            <!-- 右列：控件颜色（全局） -->
            <ctrl:ColorChipButton Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="0,8,0,0"
                                  ShowHex="True" Label="面板/显示框底色"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=PanelHex}"
                                  DefaultHex="#FFFFFF"
                                  ToolTip="输入框/下拉框/接收显示框/勾选框方框/分组卡片的底色"/>
            <ctrl:ColorChipButton Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="按钮底色"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=ButtonBgHex}"
                                  DefaultHex="#F0F0F0"
                                  ToolTip="全部按钮（点击框）的默认底色"/>
            <ctrl:ColorChipButton Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="边框色"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=BorderHex}"
                                  DefaultHex="#C9C9C9"
                                  ToolTip="控件边框色；自动派生加深控件边框、调亮分隔线与滚动条滑块"/>
            <ctrl:ColorChipButton Grid.Row="4" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="正文文字"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=TextHex}"
                                  DefaultHex="#1E1E1E"
                                  ToolTip="正文/按钮文字/输入文字颜色"/>
            <ctrl:ColorChipButton Grid.Row="5" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="次要文字"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=MutedHex}"
                                  DefaultHex="#5A5A5A"
                                  ToolTip="弱化文字（分组标题/表头/说明文字）"/>
            <ctrl:ColorChipButton Grid.Row="6" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="强调色"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=AccentHex}"
                                  DefaultHex="#0078D7"
                                  ToolTip="聚焦边框/勾选框勾选底/下拉展开边"/>
            <ctrl:ColorChipButton Grid.Row="7" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="悬停高亮"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=HoverHex}"
                                  DefaultHex="#CCE4F7"
                                  ToolTip="鼠标悬停高亮（按钮/下拉项/页签）"/>
            <ctrl:ColorChipButton Grid.Row="8" Grid.Column="2" VerticalAlignment="Top" Margin="0,6,0,0"
                                  ShowHex="True" Label="选中/按下"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=SelectedHex}"
                                  DefaultHex="#B3D4F0"
                                  ToolTip="按钮按下底色/下拉选中项/文本选择色"/>
        </Grid>
        <Button Content="关闭" IsCancel="True" Width="70" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
