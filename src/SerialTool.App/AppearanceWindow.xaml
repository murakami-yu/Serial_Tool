<Window x:Class="SerialTool.App.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:SerialTool.App.Services"
        xmlns:ctrl="clr-namespace:SerialTool.App.Controls"
        Title="外观设置" SizeToContent="WidthAndHeight"
        Background="{Binding Source={x:Static s:Appearance.Instance}, Path=MainBgHex, Converter={StaticResource HexToBrush}}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <!-- 各界面背景色集中设置：ColorChipButton 双向绑定 Appearance 单例（改色即时生效，
         MainViewModel 订阅单例变化即落盘 ui_settings.json）；每项弹层内自带「恢复默认」 -->
    <StackPanel Margin="16" Width="320">
        <TextBlock Text="各界面背景色（改色即时生效，自动保存）："
                   Foreground="{StaticResource MutedBrush}"/>
        <StackPanel Margin="0,10,0,0">
            <ctrl:ColorChipButton HorizontalAlignment="Left" Label="主窗口（含对话框）"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=MainBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="主窗口背景色；SSH/Telnet/自定义波特率等对话框跟随此色"/>
            <ctrl:ColorChipButton HorizontalAlignment="Left" Label="终端窗口" Margin="0,8,0,0"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=TerminalBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="终端窗口的框架背景（工具条/标签区，非终端内容）"/>
            <ctrl:ColorChipButton HorizontalAlignment="Left" Label="波形窗口" Margin="0,8,0,0"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=ChartBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="图表（时序/字段曲线）窗口背景"/>
            <ctrl:ColorChipButton HorizontalAlignment="Left" Label="模板编辑器" Margin="0,8,0,0"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=TemplateBgHex}"
                                  DefaultHex="#F4F4F4"
                                  ToolTip="协议模板编辑器窗口背景"/>
            <ctrl:ColorChipButton HorizontalAlignment="Left" Label="终端内容底色" Margin="0,8,0,0"
                                  Hex="{Binding Source={x:Static s:Appearance.Instance}, Path=TermContentBgHex}"
                                  DefaultHex="#1E1E1E"
                                  ToolTip="终端字符区的背景色（已打开的标签页同步生效；ANSI 调色板不变）"/>
        </StackPanel>
        <TextBlock Text="说明：仅背景色可配，面板/文字/边框色保持浅色主题体系；&#x0a;终端内容换浅色时默认文字色（浅灰）不变，建议终端底色选深色。"
                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button Content="关闭" IsCancel="True" Width="70" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
