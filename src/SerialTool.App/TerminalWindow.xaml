<Window x:Class="SerialTool.App.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="终端" Width="900" Height="560" MinWidth="380" MinHeight="260"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="Manual">

    <!-- 终端独立窗口：主窗顶部「终端」复选框控制显隐（状态记忆）；
         内容区黑底（终端默认主题背景）；未连接时整幅遮罩提示。
         生命周期与图表窗同模式：取消勾选/X=销毁，重开新建，主窗记忆位置尺寸 -->

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 终端画布宿主：TerminalView 在代码后置挂入（含右键菜单/滚回滚动条联动） -->
        <Border x:Name="TerminalHost" Grid.Column="0" CornerRadius="6" Background="Black"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                ClipToBounds="True"/>

        <!-- 滚回滚动条：备屏（vim/htop）时隐藏 -->
        <ScrollBar x:Name="TermScroll" Grid.Column="1" Margin="6,0,0,0" Width="14"
                   Orientation="Vertical" Minimum="0" Maximum="0" ViewportSize="1"
                   Scroll="TermScroll_Scroll"/>

        <!-- 未连接遮罩（IsPortOpen=false 时显示；连接建立后隐藏，断开保留终端内容只读查看） -->
        <Border x:Name="DisconnectedOverlay" Grid.ColumnSpan="2" CornerRadius="6"
                Background="#E6000000" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="未连接" Foreground="#E8E8E8" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="在主窗口打开串口 / TCP 连接后，对端输出将在此按 VT 终端方式渲染，键盘输入直接发往对端"
                           Foreground="#9A9A9A" FontSize="12" Margin="16,10,16,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
