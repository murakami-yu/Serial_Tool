<Window x:Class="SerialTool.App.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="协议模板编辑器" Width="780" Height="780" MinWidth="720" MinHeight="660"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <x:Array x:Key="FieldKinds" Type="sys:String">
            <sys:String>cmd</sys:String>
            <sys:String>fixed</sys:String>
            <sys:String>length</sys:String>
            <sys:String>data</sys:String>
        </x:Array>
        <x:Array x:Key="ChecksumNames" Type="sys:String">
            <sys:String>none</sys:String>
            <sys:String>xor</sys:String>
            <sys:String>sum8</sys:String>
            <sys:String>crc8</sys:String>
            <sys:String>crc16Modbus</sys:String>
            <sys:String>crc16Ccitt</sys:String>
            <sys:String>crc32</sys:String>
        </x:Array>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左：模板列表 + 启用状态 -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="模板列表（●=启用解析）" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="新增" Click="OnAdd"/>
                    <Button Content="删除" Click="OnDelete" Margin="8,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="List" ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate}"
                         Background="{StaticResource PanelBrush}"
                         BorderBrush="{StaticResource BorderBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Enabled, Converter={StaticResource BoolToDot}}"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Name}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- 右：模板字段（不要包外层 ScrollViewer：DataGrid 嵌套滚动容器会表头错位） -->
        <GroupBox Grid.Row="0" Grid.Column="2" Header="模板字段"
                  BorderBrush="{StaticResource BorderBrush}">
            <StackPanel Margin="4">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="名称" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Text="{Binding SelectedTemplate.Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,18,0,0" VerticalAlignment="Top">
                            <CheckBox Content="启用解析" IsChecked="{Binding SelectedTemplate.Enabled}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="帧头（HEX，如 01 或 AA 55）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Text="{Binding SelectedTemplate.Header, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="帧尾（HEX，可空；帧尾扫描模式必填）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Text="{Binding SelectedTemplate.Footer, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="校验算法" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox ItemsSource="{StaticResource ChecksumNames}"
                                      SelectedItem="{Binding SelectedTemplate.Checksum}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="校验字节序" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox SelectedIndex="{Binding SelectedTemplate.ChecksumBigEndian, Converter={StaticResource BoolToIndex}}" LostFocus="OnFieldChanged">
                                <ComboBoxItem Content="高字节在前 (CRCh CRCl)"/>
                                <ComboBoxItem Content="低字节在前 (Modbus 标准)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="帧长上限" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Width="70" Height="28" Padding="6,0"
                                     Text="{Binding SelectedTemplate.MaxFrameLength, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- 字段链 -->
                    <TextBlock Text="字段链（帧头之后 → 校验之前，按序；长度域可放任意位置）"
                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="加字段" Click="OnAddField" Padding="8,2" MinWidth="64"/>
                        <Button Content="删字段" Click="OnDeleteField" Margin="8,0,0,0" Padding="8,2" MinWidth="64"/>
                    </StackPanel>
                    <Border CornerRadius="6" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="FieldsGrid" ItemsSource="{Binding SelectedTemplate.Fields}"
                                  Background="Transparent" BorderThickness="0"
                                  GridLinesVisibility="None" AutoGenerateColumns="False"
                                  CanUserAddRows="False" SelectionMode="Single" MinHeight="110" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="类型" Width="86">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- MinWidth=0 覆盖全局 90：列宽 86 内完整放下，避免圆角边框被单元格裁出缺口 -->
                                            <ComboBox ItemsSource="{StaticResource FieldKinds}"
                                                      SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="0" HorizontalAlignment="Stretch"
                                                      Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="字节数(cmd/fixed/length)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="大端(长度域)" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding BigEndian, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="定长(data)" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DataFixedSize, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="扫描帧尾(data)" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ScanToFooter, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存并关闭" FontWeight="Bold" Click="OnSave" MinWidth="100"/>
            <Button Content="取消" Click="OnCancel" Margin="8,0,0,0" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
