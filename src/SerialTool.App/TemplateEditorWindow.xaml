<Window x:Class="SerialTool.App.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="协议模板编辑器" Width="720" Height="480"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左：模板列表 -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="模板列表" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="新增" Click="OnAdd"/>
                    <Button Content="删除" Click="OnDelete" Margin="8,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="List" ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name"
                         Background="{StaticResource PanelBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>
            </DockPanel>
        </GroupBox>

        <!-- 右：字段编辑 -->
        <GroupBox Grid.Row="0" Grid.Column="2" Header="模板字段（帧结构：帧头|长度|命令|数据|校验|帧尾）"
                  BorderBrush="{StaticResource BorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <TextBlock Text="名称" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox Text="{Binding SelectedTemplate.Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>

                    <TextBlock Text="帧头（HEX，如 AA 55）" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding SelectedTemplate.Header, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>

                    <TextBlock Text="帧尾（HEX，可空）" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding SelectedTemplate.Footer, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="长度域字节数" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox SelectedItem="{Binding SelectedTemplate.LengthBytes}" LostFocus="OnFieldChanged">
                                <sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="长度域字节序" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox x:Name="EndianCombo" SelectionChanged="OnEndianChanged">
                                <ComboBoxItem Content="小端（Modbus 习惯）"/>
                                <ComboBoxItem Content="大端"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="命令域字节数" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox SelectedItem="{Binding SelectedTemplate.CmdBytes}" LostFocus="OnFieldChanged">
                                <sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="定长数据域（长度域=0 时）" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Text="{Binding SelectedTemplate.FixedPayloadLength, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="校验算法" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <ComboBox x:Name="ChecksumCombo"
                              SelectedItem="{Binding SelectedTemplate.Checksum}"/>

                    <TextBlock Text="帧长上限（16~4096，防假帧头）" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding SelectedTemplate.MaxFrameLength, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnFieldChanged"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存并关闭" FontWeight="Bold" Click="OnSave" MinWidth="100"/>
            <Button Content="取消" Click="OnCancel" Margin="8,0,0,0" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
