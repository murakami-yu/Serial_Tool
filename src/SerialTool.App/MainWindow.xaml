<Window x:Class="SerialTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SerialTool.App.ViewModels"
        Title="Serial Tool — 通用串口调试工具"
        Width="1200" Height="740" MinWidth="1000" MinHeight="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition x:Name="RightColumnDef" Width="500"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 工具栏：连接方式 + 参数（横跨全宽） ===== -->
        <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Text="连接" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <ComboBox SelectedIndex="{Binding ConnTypeIndex}" Width="72" Margin="6,0,12,0">
                <ComboBoxItem Content="串口"/>
                <ComboBoxItem Content="TCP"/>
            </ComboBox>

            <!-- 串口参数（仅串口模式显示；下拉含设备名，如 COM3 · USB-SERIAL CH340） -->
            <WrapPanel Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="串口" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox ItemsSource="{Binding PortItems}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName"
                          Width="230" Margin="6,0,4,0"/>
                <Button Content="刷新" Command="{Binding RefreshPortsCommand}" Margin="0,0,12,0"/>

                <TextBlock Text="波特率" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox ItemsSource="{Binding BaudRates}"
                          SelectedItem="{Binding SelectedBaud}"
                          Margin="6,0,12,0"/>

                <TextBlock Text="数据位" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox ItemsSource="{Binding DataBitsOptions}"
                          SelectedItem="{Binding SelectedDataBits}"
                          Margin="6,0,12,0"/>

                <TextBlock Text="停止位" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox ItemsSource="{Binding StopBitsOptions}"
                          SelectedIndex="{Binding SelectedStopBitsIndex}"
                          Margin="6,0,12,0"/>

                <TextBlock Text="校验" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox ItemsSource="{Binding ParityOptions}"
                          SelectedIndex="{Binding SelectedParityIndex}"
                          Margin="6,0,12,0"/>
            </WrapPanel>

            <!-- TCP 参数（仅 TCP 模式显示） -->
            <WrapPanel Visibility="{Binding IsTcp, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="地址" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBox Text="{Binding TcpHost, UpdateSourceTrigger=PropertyChanged}"
                         Width="130" Margin="6,0,12,0" VerticalAlignment="Center"
                         ToolTip="串口服务器 / TCP 透传设备地址"/>
                <TextBlock Text="端口" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                         Width="70" Margin="6,0,12,0" VerticalAlignment="Center"/>
            </WrapPanel>

            <Button Command="{Binding TogglePortCommand}" FontWeight="Bold" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPortOpen}" Value="True">
                                <Setter Property="Content" Value="断开"/>
                                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPortOpen}" Value="False">
                                <Setter Property="Content" Value="连接"/>
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <CheckBox Content="多帧面板" IsChecked="{Binding ShowFramesPanel}" Margin="20,0,0,0"
                      Checked="FramesPanelToggle_Changed" Unchecked="FramesPanelToggle_Changed"
                      ToolTip="显示 / 隐藏右侧多帧发送面板（状态记忆）"/>
        </WrapPanel>

        <!-- ===== 接收区（左列） ===== -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="接收区" BorderBrush="{StaticResource BorderBrush}"
                  Foreground="{StaticResource MutedBrush}">
            <DockPanel Margin="4">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <CheckBox Content="时间戳" IsChecked="{Binding ShowTimestamp}"/>
                    <CheckBox Content="HEX 显示" IsChecked="{Binding ShowHex}" Margin="16,0,0,0"/>
                    <CheckBox Content="跟随最新" IsChecked="{Binding AutoScroll}" Margin="16,0,0,0"
                              Checked="AutoScroll_OnChecked"
                              ToolTip="勾选：新数据自动滚到底部（鼠标悬停在框上时暂停，便于查看当前行）；取消：不再自动滚动"/>
                    <CheckBox Content="记录日志" IsChecked="{Binding LogEnabled}" Margin="16,0,0,0"
                              ToolTip="{Binding LogFilePath}"/>
                    <Button Content="日志位置" Command="{Binding BrowseLogCommand}" Margin="8,0,0,0"/>
                    <Button Content="打开目录" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0"/>
                    <Button Content="清空" Command="{Binding ClearRxCommand}" Margin="24,0,0,0"/>

                    <CheckBox Content="帧解析" IsChecked="{Binding ParseEnabled}" Margin="24,0,0,0"
                              ToolTip="按模板解析接收字节流，按帧结构化显示（粘包/半包自动处理）"/>
                    <ComboBox ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="Name" Width="150" Margin="8,0,0,0"/>
                    <Button Content="模板…" Command="{Binding OpenTemplateEditorCommand}" Margin="8,0,0,0"
                            ToolTip="编辑协议帧模板"/>
                </WrapPanel>
                <TextBox x:Name="RxOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         MouseLeave="RxOutput_MouseLeave"/>
            </DockPanel>
        </GroupBox>

        <!-- ===== 发送区（左列） ===== -->
        <GroupBox Grid.Row="2" Grid.Column="0" Header="发送区" BorderBrush="{StaticResource BorderBrush}"
                  Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="10,0,0,0">
                    <CheckBox Content="HEX 发送" IsChecked="{Binding TxHexMode}" HorizontalAlignment="Center"/>
                    <Button Content="发送" Command="{Binding SendCommand}"
                            FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBox Style="{StaticResource Mono}"
                         Text="{Binding TxInput, UpdateSourceTrigger=PropertyChanged}"
                         Height="72" VerticalContentAlignment="Top"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         KeyDown="TxInput_KeyDown"
                         ToolTip="HEX 模式示例: AA 55 01 00 0F（容忍空格/逗号/换行）"/>
            </DockPanel>
        </GroupBox>

        <!-- ===== 分隔条：拖动调整右栏宽度（平时隐形，悬停显示手柄） ===== -->
        <GridSplitter x:Name="FramesSplitter" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" Focusable="False"
                      Cursor="SizeWE"/>

        <!-- ===== 多帧发送（右列，纵向占满；可通过工具栏开关隐藏） ===== -->
        <GroupBox x:Name="FramesPanel" Grid.Row="1" Grid.RowSpan="2" Grid.Column="2"
                  Header="多帧发送（勾选循环按周期发送，最小 50ms）"
                  BorderBrush="{StaticResource BorderBrush}" Margin="10,0,0,0">
            <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="添加" Command="{Binding AddFrameCommand}"/>
                    <Button Content="删除选中" Command="{Binding RemoveSelectedFrameCommand}" Margin="8,0,0,0"/>
                    <Button Content="清空" Command="{Binding ClearFramesCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- 表格圆角框：包裹层提供白底 + 圆角边框（DataGrid 自身透明填充） -->
                <Border CornerRadius="6"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Margin="0,2,0,0"
                        SnapsToDevicePixels="True">
                <DataGrid ItemsSource="{Binding SendFrames}"
                          SelectedItem="{Binding SelectedFrame}"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}"
                                            IsReadOnly="True" Width="32" CanUserResize="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <!-- 锁定前景色：行选中时系统会把文字刷白，导致透明底上看不见 -->
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="内容" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,2" Margin="2" VerticalAlignment="Center"
                                             FontFamily="Cascadia Mono, Consolas"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="备注" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,2" Margin="2" VerticalAlignment="Center"
                                             Foreground="{StaticResource MutedBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="HEX" Width="44" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsHex, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="周期ms" Width="64" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PeriodMs, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="循环" Width="44" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsCyclic, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="62" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="发送" Command="{Binding SendCommand}"
                                            Padding="4,2" MinWidth="44"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
            </DockPanel>
        </GroupBox>

        <!-- ===== 状态栏（横跨全宽） ===== -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="0,6,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}">
                    <Run Text="RX: "/><Run Text="{Binding RxCount, Mode=OneWay}"/>
                    <Run Text="  TX: "/><Run Text="{Binding TxCount, Mode=OneWay}"/>
                    <Run Text="  帧✓ "/><Run Text="{Binding FrameOkCount, Mode=OneWay}"/>
                    <Run Text=" / ✗ "/><Run Text="{Binding FrameErrCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
