<Window x:Class="SerialTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SerialTool.App.ViewModels"
        xmlns:ctrl="clr-namespace:SerialTool.App.Controls"
        xmlns:s="clr-namespace:SerialTool.App.Services"
        Title="Serial Tool — 通用串口调试工具"
        Width="1290" Height="740" MinWidth="1290" MinHeight="660"
        SizeChanged="MainWindow_SizeChanged"
        Background="{Binding Source={x:Static s:Appearance.Instance}, Path=MainBgHex, Converter={StaticResource HexToBrush}}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- 窗口 MinWidth=1290：顶部功能条不换行阈值在加入「终端」复选框后实测 ~1246
         （2026-09-19 截图实测；原 2026-09-01 的 ~1185 不含终端）+ 字体度量余量；
         2026-09-26 「波形/终端」复选框改按钮（按钮 MinWidth 64，两枚共加宽 ~38，阈值 ~1284 仍在 1290 内）；
         再窄这些行会折行错位。默认宽与 MinWidth 一致，启动即不换行。
         MinHeight=660 为串口/TCP 模式值；SSH 模式底条加高，代码同步抬到 710 -->

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumnDef" Width="*" MinWidth="420"/>
            <ColumnDefinition x:Name="SplitterColumnDef" Width="12"/>
            <ColumnDefinition x:Name="RightColumnDef" Width="500" MinWidth="500"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
            <!-- 底部条默认 215（串口/TCP 四行）；SSH 模式五行内容由代码切到 264，
                 窗口 MinHeight 同步 660→710（低于各行 MinHeight 之和时 Grid 星比压缩会削底条），
                 见 MainWindow.xaml.cs.ApplyBottomBarHeight -->
            <RowDefinition x:Name="BottomBarRow" Height="215" MinHeight="215" MaxHeight="380"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部功能条（独立框）：帧解析组 | 接收显示组。WrapPanel：窗口变窄时整组换行，不裁切 ===== -->
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Header="帧解析 · 接收显示"
                  BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource MutedBrush}">
            <WrapPanel Margin="4">
                <!-- 帧解析组 -->
                <CheckBox Content="启用" IsChecked="{Binding ParseEnabled}" VerticalAlignment="Center"
                          ToolTip="按模板解析接收字节流，按帧结构化显示（粘包/半包自动处理；多个启用模板并行仲裁）"/>
                <ComboBox ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate}"
                          DisplayMemberPath="Name" Width="150" Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip="当前查看的模板"/>
                <Button Content="模板…" Command="{Binding OpenTemplateEditorCommand}" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="编辑协议帧模板（编辑器中勾选「启用」的模板并行参与解析）"/>

                <!-- 分隔竖线 -->
                <Rectangle Width="1" Margin="16,2" Fill="{DynamicResource BorderBrush}"
                           VerticalAlignment="Stretch"/>

                <!-- 接收显示组（HEX 显示已迁至「发送区」第一排） -->
                <CheckBox Content="时间戳" IsChecked="{Binding ShowTimestamp}" Margin="4,0,0,0"
                          VerticalAlignment="Center"/>
                <CheckBox Content="跟随最新" IsChecked="{Binding AutoScroll}" Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Checked="AutoScroll_OnChecked"
                          ToolTip="勾选：新数据自动滚到底部（鼠标悬停在框上时暂停，便于查看当前行）；取消：不再自动滚动"/>
                <CheckBox Content="记录日志" IsChecked="{Binding LogEnabled}" Margin="12,0,0,0"
                          VerticalAlignment="Center" ToolTip="{Binding LogFilePath}"/>
                <Button Content="日志位置" Command="{Binding BrowseLogCommand}" Margin="16,0,0,0"/>
                <Button Content="打开目录" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0"/>
                <Button Content="清空" Command="{Binding ClearRxCommand}" Margin="8,0,0,0"/>

                <!-- 分隔竖线 -->
                <Rectangle Width="1" Margin="16,2" Fill="{DynamicResource BorderBrush}"
                           VerticalAlignment="Stretch"/>

                <!-- 接收过滤组：只影响视图，缓冲与日志始终全量 -->
                <CheckBox Content="过滤" IsChecked="{Binding FilterEnabled}" Margin="0,0,0,0"
                          VerticalAlignment="Center"
                          ToolTip="只显示命中行（数据缓冲与日志文件不受影响）"/>
                <TextBox Text="{Binding RxFilterText, UpdateSourceTrigger=PropertyChanged}"
                         Width="110" Margin="6,0,0,0" VerticalAlignment="Center"
                         Style="{StaticResource Mono}"
                         ToolTip="HEX 子串（如 AA 55，忽略空格/大小写）或文本子串"/>
                <Button Content="波形" Click="WavePanelButton_Click" Margin="16,0,0,0" VerticalAlignment="Center"
                        ToolTip="打开图表窗口（独立窗口，可脱离主窗摆放；上次退出时开着则随启动打开，关闭用窗口 X）"/>
                <Button Content="终端" Click="TerminalPanelButton_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="打开终端窗口（VT100/xterm 终端仿真：串口/TCP 字节流按终端方式渲染，键盘输入直接发往对端，支持滚回/复制粘贴；独立窗口，关闭用窗口 X）"/>
                        <CheckBox Content="多帧面板" IsChecked="{Binding ShowFramesPanel}" Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="FramesPanelToggle_Changed" Unchecked="FramesPanelToggle_Changed"
                                  ToolTip="显示 / 隐藏右侧多帧发送面板（状态记忆）"/>
            </WrapPanel>
        </GroupBox>

        <!-- ===== 左列：接收区（图表面板已迁独立窗口 ChartWindow，由顶部「波形」按钮打开） ===== -->
        <!-- 左列容器裁切越界渲染：接收区无论内容多高，绘制都限制在本区内，绝不覆盖下方框架；
             顶部 10 与右列面板/底部条对齐，各框架垂直间距统一 -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" ClipToBounds="True">
            <!-- 接收区（纯数据展示）。RxOutput 为 RichTextBox：支持按方向逐行着色 -->
            <GroupBox BorderBrush="{DynamicResource BorderBrush}"
                      Foreground="{DynamicResource MutedBrush}">
                <GroupBox.Header>
                    <!-- 标题行右侧挂 TX/RX 颜色设置（弹层为独立 HWND，不受本区 ClipToBounds 裁剪） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="接收区" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ctrl:ColorChipButton Label="发送色" Hex="{Binding TxColorHex}"
                                                  DefaultHex="#0078D7"
                                                  ToolTip="设置发送行的显示颜色（→ 手动发送 / ⇄ 自动应答回显）"/>
                            <ctrl:ColorChipButton Label="接收色" Hex="{Binding RxColorHex}"
                                                  DefaultHex="#1E1E1E" Margin="8,0,0,0"
                                                  ToolTip="设置接收行的显示颜色（← 数据 / ✓✗ 解析帧）"/>
                        </StackPanel>
                    </Grid>
                </GroupBox.Header>
                <RichTextBox x:Name="RxOutput" Style="{StaticResource MonoRich}"
                             Margin="4"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             MouseLeave="RxOutput_MouseLeave"/>
            </GroupBox>

        </Grid>

        <!-- ===== 横向分隔条：拖动手动调整发送区/串口配置条的高度。
             底部条初始高度由代码按连接方式设定（串口/TCP 四行 = 215，SSH 五行 = 264，
             见 MainWindow.xaml.cs.ApplyBottomBarHeight；215 = 四行内容 ~148 DIP + 标题/边距 ~31
             + 余量 18 DIP——余量小于 8 会被显示缩放取整/字体度量差异吃掉致按钮底部被削），
             分隔条只放大不缩小、任何拖动都不裁切，
             输入框内容再多也不会自动撑高挤压接收区 ===== -->
        <GridSplitter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="8" Margin="0,4,0,0"
                      Style="{StaticResource RowGridSplitter}"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Focusable="False" Cursor="SizeNS"/>

        <!-- ===== 底部条（横跨全宽）：发送区 + 串口配置两排 ===== -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 发送区：输入框独占左侧纵向空间；控制项在右侧竖排（引脚两行 / HEX 收发 / 定时发送），
                 发送/清空贴底。输入框宽度不随控制项变化，高度由横向分隔条手动调控 -->
            <GroupBox Grid.Column="0" Header="发送区" BorderBrush="{DynamicResource BorderBrush}"
                      Foreground="{DynamicResource MutedBrush}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 输入框：独占左侧；Enter 发送、Shift+Enter 换行 -->
                    <TextBox Grid.Column="0" Style="{StaticResource Mono}"
                             Text="{Binding TxInput, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="72" VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             KeyDown="TxInput_KeyDown"
                             ToolTip="HEX 模式示例: AA 55 01 00 0F（容忍空格/逗号/换行）"/>

                    <!-- 右侧控制区：RTS/DTR 输出控制一行（仅串口）+ HEX 收发同行 + 定时发送独占一行；
                         CTS/DSR 输入指示在底部状态栏「RX:」左侧；按钮贴底等宽拉满 -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- 三内容行等分整列高度（内容垂直居中）：底部条拖高时间距均匀变大，排布始终均衡；
                                 按钮行为末行（Auto 贴底）——曾误写 Grid.Row=4 越界，WPF 钳到末行才没露馅 -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 行1：☐RTS ☐DTR 输出控制同列对齐（仅串口；连接后可用）。CTS/DSR 指示已迁至底部状态栏 -->
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="RTS" IsChecked="{Binding RtsOn}"
                                  IsEnabled="{Binding CanControlPins}" VerticalAlignment="Center"
                                  Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}"
                                  ToolTip="RTS 输出电平手动控制（ESP32/STM32 复位与 boot 模式常用）；连接串口后可用"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="DTR" IsChecked="{Binding DtrOn}"
                                  IsEnabled="{Binding CanControlPins}" Margin="24,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}"
                                  ToolTip="DTR 输出电平手动控制；连接串口后可用"/>

                        
                        <!-- 行2：HEX 接收显示 + HEX 发送 同行 -->
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="HEX 显示" IsChecked="{Binding ShowHex}"
                                  VerticalAlignment="Center"
                                  ToolTip="接收区按十六进制显示（取消则按文本解码显示）"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="HEX 发送" IsChecked="{Binding TxHexMode}"
                                  Margin="24,0,0,0" VerticalAlignment="Center"/>

                        <!-- 行3：定时发送独占一行（勾选即按周期自动重发输入框内容，先立即发一帧；
                             与多帧循环同一 50ms 调度节拍，空内容/HEX 非法跳过本轮）。
                             输入框弹性填满行剩余宽度（MinWidth 56 保底）：位数再多不裁字，
                             行右缘始终与 HEX 行、底部按钮对齐 -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <CheckBox Content="定时发送" IsChecked="{Binding TxCyclic}" VerticalAlignment="Center"
                                      ToolTip="勾选后按周期自动重发左侧输入框内容（勾选时先立即发一帧）；状态记忆"/>
                            <!-- 宽度 88：最长 6 位周期值（999999ms）也完整显示 -->
                            <TextBox Text="{Binding TxPeriodMs, UpdateSourceTrigger=PropertyChanged}"
                                     Width="88" Margin="6,0,0,0" VerticalAlignment="Center"
                                     ToolTip="定时发送周期（毫秒，最小 50）"/>
                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <!-- 按钮行（末行 Auto）：两键等宽拉满控制区，左右边界与上方元素列对齐（Enter 发送仍可用） -->
                        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="发送" Command="{Binding SendCommand}" FontWeight="Bold"/>
                            <Button Grid.Column="2" Content="清空" Command="{Binding ClearTxCommand}"
                                    ToolTip="清空发送输入框内容"/>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- 串口配置：每行拉通整行宽（连接方式 / 设备下拉+刷新 / 四参数一行 / 主按钮整行），
                 面板宽度贴合最宽行 —— 不留横向空白 -->
            <GroupBox Grid.Column="2" Header="串口配置" BorderBrush="{DynamicResource BorderBrush}"
                      Foreground="{DynamicResource MutedBrush}">
                <Grid Margin="4" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行（串口模式）：设备下拉弹性填满至刷新按钮（MaxWidth 380 仅防超长设备名撑爆面板，
                         取 300 会中途截停、右缘留缝） -->
                    <DockPanel Grid.Row="0"
                               Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="串口" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshPortsCommand}"
                                Margin="8,0,0,0"/>
                        <!-- 下拉含设备名，如 COM3 · USB-SERIAL CH340 -->
                        <ComboBox ItemsSource="{Binding PortItems}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="220" MaxWidth="380" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 第一行（TCP 模式）：地址弹性填满，端口右置 -->
                    <DockPanel Grid.Row="0"
                               Visibility="{Binding IsTcp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="地址" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="端口" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding TcpHost, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="6,0,12,0" VerticalAlignment="Center"
                                 ToolTip="串口服务器 / TCP 透传设备地址"/>
                    </DockPanel>

                    <!-- 第一行（SSH 模式）：主机弹性填满，端口右置（默认 22） -->
                    <DockPanel Grid.Row="0"
                               Visibility="{Binding IsSsh, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="主机" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="端口" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBox Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding SshHost, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="6,0,12,0" VerticalAlignment="Center"
                                 ToolTip="SSH 服务器地址（IP 或主机名）"/>
                    </DockPanel>

                    <!-- 第二行：连接方式下拉弹性填满整行 -->
                    <DockPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="连接" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox SelectedIndex="{Binding ConnTypeIndex}" Margin="6,0,0,0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="串口"/>
                            <ComboBoxItem Content="TCP"/>
                            <ComboBoxItem Content="SSH"/>
                        </ComboBox>
                    </DockPanel>

                    <!-- 第三行（仅串口模式）：四个通信参数一行排开，下拉各自贴内容宽（等宽会撑出假空白） -->
                    <Grid Grid.Row="2" Margin="0,12,0,0"
                          Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 自定义波特率走下拉末尾「自定义…」选项（输入对话框）；主框不直接键入 -->
                        <TextBlock Grid.Column="0" Text="波特率" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                  ItemsSource="{Binding BaudRates}"
                                  SelectedItem="{Binding SelectedBaudItem, Mode=TwoWay}"
                                  ToolTip="选择常用波特率；末尾「自定义…」可输入任意值"/>
                        <TextBlock Grid.Column="2" Text="数据位" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="44"
                                  ItemsSource="{Binding DataBitsOptions}"
                                  SelectedItem="{Binding SelectedDataBits}"/>
                        <TextBlock Grid.Column="4" Text="停止位" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox Grid.Column="5" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="44"
                                  ItemsSource="{Binding StopBitsOptions}"
                                  SelectedIndex="{Binding SelectedStopBitsIndex}"/>
                        <TextBlock Grid.Column="6" Text="校验" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <ComboBox Grid.Column="7" Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="44"
                                  ItemsSource="{Binding ParityOptions}"
                                  SelectedIndex="{Binding SelectedParityIndex}"/>
                    </Grid>

                    <!-- 第三行（SSH 模式）：用户名弹性填满 + 认证方式右置 -->
                    <DockPanel Grid.Row="2" Margin="0,12,0,0"
                               Visibility="{Binding IsSsh, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="用户" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="认证" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <ComboBox SelectedIndex="{Binding SshAuthIndex}" Margin="6,0,0,0"
                                      VerticalAlignment="Center" MinWidth="72">
                                <ComboBoxItem Content="密码"/>
                                <ComboBoxItem Content="私钥"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBox Text="{Binding SshUser, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="6,0,12,0" VerticalAlignment="Center" MinWidth="120"
                                 ToolTip="SSH 登录用户名"/>
                    </DockPanel>

                    <!-- 第四行（SSH 模式）：认证明细（密码 或 私钥文件+口令；凭据不落盘） -->
                    <DockPanel Grid.Row="3" Margin="0,10,0,0"
                               Visibility="{Binding IsSshPasswordAuth, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="密码" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <PasswordBox x:Name="SshPasswordBox" Margin="6,0,0,0" VerticalAlignment="Center"
                                     PasswordChanged="SshPasswordBox_PasswordChanged"
                                     ToolTip="登录密码（不保存到磁盘）"/>
                    </DockPanel>
                    <DockPanel Grid.Row="3" Margin="0,10,0,0"
                               Visibility="{Binding IsSshKeyAuth, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="私钥" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="口令" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <PasswordBox x:Name="SshKeyPassBox" Width="90" Margin="4,0,0,0" VerticalAlignment="Center"
                                         PasswordChanged="SshKeyPassBox_PasswordChanged"
                                         ToolTip="私钥口令（无口令可留空，不保存到磁盘）"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="浏览…" Margin="6,0,0,0"
                                Click="BrowseSshKey_Click" VerticalAlignment="Center"
                                ToolTip="选择私钥文件（OpenSSH / PEM 格式；PuTTY .ppk 需先转换为 OpenSSH 格式）"/>
                        <TextBox Text="{Binding SshKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="6,0,6,0" VerticalAlignment="Center" MinWidth="80"
                                 ToolTip="私钥文件路径（~/.ssh/id_ed25519 等；ppk 不支持）"/>
                    </DockPanel>

                    <!-- 第五行：连接/断开主按钮整行宽（TCP/串口模式明细行隐藏后仍贴底） -->
                    <Button Grid.Row="4" Margin="0,12,0,0" Command="{Binding TogglePortCommand}"
                            FontWeight="Bold" Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPortOpen}" Value="True">
                                        <Setter Property="Content" Value="断开"/>
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPortOpen}" Value="False">
                                        <Setter Property="Content" Value="连接"/>
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ===== 分隔条：拖动调整右栏宽度（平时隐形，悬停显示手柄） ===== -->
        <GridSplitter x:Name="FramesSplitter" Grid.Row="1" Grid.Column="1" Width="12"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" Focusable="False"
                      Cursor="SizeWE"/>

        <!-- ===== 右列工具面板（与接收区同高；可通过状态栏开关隐藏）：多帧发送 / 自动应答。裁切保证不越界覆盖 ===== -->
        <GroupBox x:Name="FramesPanel" Grid.Row="1" Grid.Column="2" ClipToBounds="True"
                  Header="发送工具（多帧发送 / 自动应答）"
                  BorderBrush="{DynamicResource BorderBrush}" Margin="0,10,0,0">
            <TabControl Margin="4" Background="Transparent">
                <!-- 第一页：多帧发送 -->
                <TabItem Header="多帧发送（循环最小 50ms）">
                    <!-- 表格占剩余高度（出滚动条），按钮排固定在底部，窗口再矮也不会被挤出去 -->
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 表格圆角框：包裹层提供白底 + 圆角边框（DataGrid 自身透明填充） -->
                        <Border Grid.Row="0" CornerRadius="6"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Margin="0,2,0,0"
                                SnapsToDevicePixels="True">
                            <DataGrid ItemsSource="{Binding SendFrames}"
                                      SelectedItem="{Binding SelectedFrame}"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}"
                                                        IsReadOnly="True" Width="32" CanUserResize="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <!-- 锁定前景色：行选中时系统会把文字刷白，导致透明底上看不见 -->
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="内容" Width="1.6*" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                         Style="{StaticResource Mono}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="备注" Width="120" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource MutedBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="HEX" Width="44" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsHex, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="周期ms" Width="64" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PeriodMs, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="循环" Width="44" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsCyclic, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="操作" Width="62" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="发送" Command="{Binding SendCommand}"
                                                        Padding="4,2" MinWidth="44"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="添加" Command="{Binding AddFrameCommand}"/>
                            <Button Content="删除选中" Command="{Binding RemoveSelectedFrameCommand}" Margin="8,0,0,0"/>
                            <Button Content="清空" Command="{Binding ClearFramesCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 第二页：自动应答（收到匹配的成功帧 → 延迟回发；需开启帧解析） -->
                <TabItem Header="自动应答（需开帧解析）">
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="0,2,0,4" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="收到匹配的成功帧后自动回发回复帧（延迟调度粒度 50ms，回显行 ⇄）；匹配条件：模板 + 命令前缀 + 子串（均可选，同时配置取与）"/>

                        <Border Grid.Row="1" CornerRadius="6"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Margin="0,2,0,0"
                                SnapsToDevicePixels="True">
                            <DataGrid ItemsSource="{Binding AutoReplies}"
                                      SelectedItem="{Binding SelectedReply}"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="启用" Width="40" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="名称" Width="*" MinWidth="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="模板" Width="*" MinWidth="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource MutedBrush}"
                                                         ToolTip="限定来源模板名，空 = 任意模板"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="命令HEX" Width="72" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CommandHex, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                         Style="{StaticResource Mono}"
                                                         ToolTip="命令域前缀过滤，空 = 不过滤"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="匹配HEX" Width="72" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MatchHex, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                         Style="{StaticResource Mono}"
                                                         ToolTip="帧内任意位置子串，空 = 不过滤"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="回复HEX" Width="1.6*" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ReplyHex, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                         Style="{StaticResource Mono}"
                                                         ToolTip="命中后发送的完整帧（HEX）"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="延迟ms" Width="58" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="仅一次" Width="48" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Once, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="首次命中后自动禁用（握手类指令防重复应答）"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="命中" Binding="{Binding HitCount, Mode=OneWay}"
                                                        IsReadOnly="True" Width="48" CanUserResize="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="添加" Command="{Binding AddReplyCommand}"/>
                            <Button Content="删除选中" Command="{Binding RemoveSelectedReplyCommand}" Margin="8,0,0,0"/>
                            <Button Content="清空" Command="{Binding ClearRepliesCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </GroupBox>

        <!-- ===== 状态栏（横跨全宽） ===== -->
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="0,6,0,0">
            <DockPanel>
                <!-- 外观设置入口：状态栏左侧（顶条已贴近 1290 宽度上限，不加控件）；
                     MinHeight=0 压掉全局按钮样式的 28px 基线，状态栏保持单行高 -->
                <Button DockPanel.Dock="Left" Content="外观…" Click="Appearance_Click"
                        MinWidth="0" MinHeight="0" Padding="10,1" Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip="设置各界面背景色（主窗/终端/波形/模板编辑器/终端内容，即时生效并保存）"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}">
                    <Run Text="RX: "/><Run Text="{Binding RxCount, Mode=OneWay}"/>
                    <Run Text="  TX: "/><Run Text="{Binding TxCount, Mode=OneWay}"/>
                    <Run Text="  速率 "/><Run Text="{Binding RxRateText, Mode=OneWay}"/>
                    <Run Text="  帧✓ "/><Run Text="{Binding FrameOkCount, Mode=OneWay}"/>
                    <Run Text=" / ✗ "/><Run Text="{Binding FrameErrCount, Mode=OneWay}"/>
                    <Run Text="  时长 "/><Run Text="{Binding ElapsedText, Mode=OneWay}"/>
                </TextBlock>
                <!-- CTS/DSR 输入指示：绿=有效 灰=无效，50ms 轮询（仅串口；位于 RX/TX 计数左侧） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#9AA0A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CtsOn}" Value="True">
                                            <Setter Property="Fill" Value="#3DA35D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="CTS" VerticalAlignment="Center" Margin="5,0,0,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#9AA0A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DsrOn}" Value="True">
                                            <Setter Property="Fill" Value="#3DA35D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="DSR" VerticalAlignment="Center" Margin="5,0,0,0"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <!-- 「多帧面板」开关已迁至「发送区」第一排（与 HEX 显示/发送、定时发送同一排） -->
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
            </DockPanel>
        </Border>

        <!-- 拖动预览层（RootGrid 最后声明 = 置顶）：{DynamicResource ButtonBgBrush} 60% 半透明预览带（按钮/下拉框体同款灰，
             透出下方面板）覆盖落点后右面板将占的区域 + {DynamicResource ControlBorderBrush} 竖线 + 按钮灰底灰边宽度标签。
             拖动中两面板完全静止
             不重绘（本机虚拟显示驱动对连续失效的重内容子树带 ±1~2px 呈现偏移 = 跟手毛刺抖动），
             只有本预览层跟手；松手一次落定 -->
        <Grid x:Name="DragPreview" Grid.Row="1" Grid.ColumnSpan="3"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle x:Name="PreviewBand" Fill="{DynamicResource ButtonBgBrush}" Opacity="0.6"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Rectangle x:Name="PreviewLine" Width="2" Fill="{DynamicResource ControlBorderBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
            <Border x:Name="PreviewLabel" Background="{DynamicResource ButtonBgBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="6,2"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="PreviewLabelText" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
