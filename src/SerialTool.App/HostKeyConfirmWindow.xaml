<Window x:Class="SerialTool.App.HostKeyConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主机指纹确认" SizeToContent="WidthAndHeight"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <!-- SSH 首次连接 TOFU / 指纹变更警告（同步模态：连接挂起等待用户裁决） -->

    <StackPanel Margin="16" Width="420" MaxWidth="480">
        <TextBlock x:Name="Headline" Text="首次连接到该服务器" FontWeight="Bold" FontSize="14"
                   Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="Warn" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                   Foreground="#C00000" FontWeight="Bold"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="主机" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="HostText" Grid.Row="0" Grid.Column="1" Margin="12,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="算法" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="AlgoText" Grid.Row="1" Grid.Column="1" Margin="12,2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="指纹" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
            <TextBlock x:Name="FpText" Grid.Row="2" Grid.Column="1" Margin="12,2"
                       Style="{StaticResource Mono}" TextWrapping="Wrap"/>
        </Grid>

        <TextBlock x:Name="Md5Text" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                   Style="{StaticResource Mono}" TextWrapping="Wrap" FontSize="11"/>

        <TextBlock Text="接受后指纹将保存到 Config/known_hosts.json，之后连接不再询问。"
                   Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="AcceptBtn" Content="信任并连接" IsDefault="True" Click="OnAccept"
                    MinWidth="96" FontWeight="Bold" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                <Setter Property="Content" Value="仍要信任（覆盖旧指纹）"/>
                                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="拒绝" IsCancel="True" Margin="8,0,0,0" MinWidth="70" Click="OnReject"/>
        </StackPanel>
    </StackPanel>
</Window>
