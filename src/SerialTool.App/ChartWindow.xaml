<Window x:Class="SerialTool.App.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="图表 — 时序 / 字段曲线"
        Width="680" Height="540" MinWidth="520" MinHeight="400"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="Manual">

    <!-- 图表独立窗口：主窗顶部「波形」复选框控制显隐（默认关闭，勾选状态记忆）；
         Manual 启动位置由主窗定位（贴主窗右侧）；
         XAML 的 MinWidth/MinHeight 只是兜底，真实最小尺寸由 OnSourceInitialized 按内容完整显示实测标定 -->

    <Grid Margin="12">
        <!-- 图表：时序图 / 字段曲线 两页（内容与原主窗内嵌面板一致）。
             裁切兜底：内容最小高度之和若超出本框（极端缩放），在框内裁切而非越界 -->
        <GroupBox Header="图表（时序 / 字段曲线）" BorderBrush="{StaticResource BorderBrush}"
                  Foreground="{StaticResource MutedBrush}" ClipToBounds="True">
            <TabControl x:Name="MainTab" Margin="4" Background="Transparent">
                <TabControl.Template>
                    <!-- 自定义模板：页签行 = TabPanel + 「？」帮助按钮水平排开——按钮是页签的**平级**元素
                         （紧随最后一个页签之后、不在任何页签的边框内，2026-09-03 用户要求）。
                         注意模板有独立名称域：外部 Popup 的 PlacementTarget 不能用 ElementName 绑定
                         到模板内按钮，由 Click 处理器用 sender 指定 -->
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                                <!-- 「？」帮助：20px 圆形小按钮（局部模板：CornerRadius=半宽成正圆）。
                                     全局按钮样式的 MinWidth=64/MinHeight=28/Padding=12,4 是 Setter，
                                     不走自定义模板、且 MinWidth 会把局部 Width 顶上去，必须显式清零；
                                     边框 1.5px：1px 灰边在 150% DPI 抗锯齿后白色底上几乎不可见 -->
                                <Button Content="?" Width="20" Height="20" Margin="8,0,0,0"
                                        MinWidth="0" MinHeight="0" Padding="0"
                                        FontSize="12" VerticalAlignment="Center"
                                        Click="FieldPlotHelp_Click" ToolTip="使用说明">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="10"
                                                    Background="#F0F0F0" BorderBrush="#ADADAD" BorderThickness="1.5"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#B3D4F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <!-- 第一页：时序图（帧/数据块按时间戳入图；绿=校验通过 红=错误帧；滚轮缩放/拖动平移） -->
                <TabItem Header="时序图">
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox Content="跟随最新" IsChecked="{Binding WaveFollow}"
                                      ToolTip="勾选：视图自动锁定最近 30 秒；取消后可自由缩放平移"/>
                            <TextBlock Text="蓝=RX 橙=TX 逐位方波(起始位+8数据位+停止位) 按波特率重建  跟随窗口100ms 滚轮缩放·拖动平移"
                                       Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <!-- 图表画布：白色圆角卡片（ScottPlot 背景置透明，白底与圆角由本 Border 提供）。
                             MinHeight=200 是方波可读性地板（RX/TX 双电平带 + 轴刻度），
                             经 CalibrateMinSize 折算进窗口最小高：窗口缩到最小方波也不会被压扁。
                             注意本 Border 必须是 DockPanel 最后一个子元素（填充剩余空间）——
                             曾因 Popup 放在它后面接管填充位而被挤成 0 宽（见窗口根 Grid 里 Popup 注释） -->
                        <Border x:Name="WaveHost" CornerRadius="6" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <sp:WpfPlot x:Name="WavePlot" MinHeight="200" Background="Transparent"/>
                        </Border>
                    </DockPanel>
                </TabItem>

                <!-- 第二页：字段曲线（仅解析成功帧采样）；「？」帮助按钮在上方 TabControl 模板里（页签平级） -->
                <TabItem Header="字段曲线">
                    <DockPanel Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="添加" Command="{Binding AddPlotCommand}"/>
                                <Button Content="删除选中" Command="{Binding RemoveSelectedPlotCommand}" Margin="8,0,0,0"/>
                                <Button Content="清空" Command="{Binding ClearPlotsCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <CheckBox Content="跟随最新" IsChecked="{Binding WaveFollow}"
                                      VerticalAlignment="Center"
                                      ToolTip="勾选：视图自动锁定最近 60 秒；取消后可自由缩放平移"/>
                            <TextBlock Text="需开启「帧解析」，按曲线配置从帧数据域取值  滚轮缩放·拖动平移"
                                       Margin="16,0,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>

                        <!-- 配置表：底部固定 96px（表头 + 两行，宽表可横向滚动），高度恒定不参与压缩；
                             圆角卡片与多帧/自动应答表格同款。曲线画布的 MinHeight 保证缩放时图形始终可读 -->
                        <Border DockPanel.Dock="Bottom" Height="96" Margin="0,6,0,0"
                                CornerRadius="6" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <DataGrid ItemsSource="{Binding FieldPlots}"
                                      SelectedItem="{Binding SelectedPlot}"
                                      VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="启用" Width="40" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="名称" Width="*" MinWidth="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="模板" Width="*" MinWidth="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                     Foreground="{StaticResource MutedBrush}"
                                                     ToolTip="限定来源模板名，空 = 任意模板"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="命令HEX" Width="66" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding CommandHex, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"
                                                     Style="{StaticResource Mono}"
                                                     ToolTip="命令域前缀过滤，空 = 不过滤"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="偏移" Width="44" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="宽度" Width="54" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- MinWidth=0 覆盖全局下拉框样式的 90：列仅 54 宽，
                                                 不清零会横向溢出压住右侧「大端」列边界 -->
                                            <ComboBox ItemsSource="{Binding WidthChoices}"
                                                      SelectedItem="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="0"
                                                      Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="大端" Width="38" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding BigEndian, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="符号" Width="38" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Signed, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="缩放" Width="52" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="单位" Width="46" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" Margin="2" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 曲线画布：白色圆角卡片（同左页时序图）。
                             MinHeight=200 是曲线可读性地板（2026-09-03 用户要求：窗口缩到最小也不许把
                             图形压到看不清）；本页为窗口最小高的瓶颈（工具行 + 96px 配置表 + 本画布地板），
                             即窗口最小高 ≈ 配置表恒定 96 + 画布地板 200 + 其余固定开销 -->
                        <!-- 曲线画布：白色圆角卡片（同左页时序图）。
                             MinHeight=200 是曲线可读性地板；本 Border 必须是 DockPanel 最后一个子元素
                             （填充剩余空间）——曾因 Popup 放在它后面接管填充位而被挤成 0 宽（见根 Grid Popup 注释） -->
                        <Border x:Name="FieldHost" CornerRadius="6" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <sp:WpfPlot x:Name="FieldPlotCtl" MinHeight="200" Background="Transparent"/>
                        </Border>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </GroupBox>

        <!-- 「？」使用说明弹层：圆角卡片 + 阴影（同全局 ToolTip 风格放大版）；StaysOpen=False 点窗口内
             任意别处即关闭。PlacementTarget 不能用 ElementName 绑定（帮助按钮在 TabControl 模板名称域内），
             由 Click 处理器以 sender 指定。**必须放在窗口根 Grid**：早前放在字段曲线页的 DockPanel 里，
             作为 DockPanel 最后一个子元素接管了「填充剩余空间」职责（Popup 关闭时占 0 尺寸），
             把默认 Dock=Left 的曲线画布 Border 挤成 0 宽——坐标轴消失的真正根因 -->
        <Popup x:Name="FieldPlotHelpPopup"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="6" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="14,10" MaxWidth="440" Margin="12"
                    TextElement.Foreground="{StaticResource TextBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="字段曲线 · 使用说明" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="21">
                        <Run Text="1. 数据来源：仅从「帧解析」判定成功的帧中采样——先在主窗顶部勾选解析「启用」并配好模板，本页才有数据。"/><LineBreak/>
                        <Run Text="2. 点「添加」新增曲线，在下方表格配置取值规则："/><LineBreak/>
                        <Run Text="　· 模板：限定来源模板名，留空 = 任意模板；"/><LineBreak/>
                        <Run Text="　· 命令HEX：只采样命令域以此前缀开头的帧，留空 = 不过滤；"/><LineBreak/>
                        <Run Text="　· 偏移 / 宽度：从帧数据域第 N 字节起取 1 / 2 / 4 字节；"/><LineBreak/>
                        <Run Text="　· 大端 / 符号：多字节值的字节序与有无符号；"/><LineBreak/>
                        <Run Text="　· 缩放 / 单位：原始值 × 缩放 = 物理量，单位拼在图例名后。"/><LineBreak/>
                        <Run Text="3. 勾选行首「启用」开始采样；「删除选中 / 清空」管理配置，改动自动保存。"/><LineBreak/>
                        <Run Text="4. 「跟随最新」锁定最近 60 秒；取消后可滚轮缩放、拖动平移。"/><LineBreak/>
                        <Run Text="5. 图例暂不能渲染中文，建议曲线名用英文。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
