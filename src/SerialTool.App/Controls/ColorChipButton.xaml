<UserControl x:Class="SerialTool.App.Controls.ColorChipButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SerialTool.App.Controls">
    <!-- 颜色选择控件：色块按钮 + 取色弹层（HSV 色图自由取色 / 预设色板快选 / HEX/RGB 精确输入，
         视觉语言照抄全局按钮/下拉框模板） -->
    <Grid>
        <ToggleButton x:Name="Toggle" Cursor="Hand" VerticalAlignment="Center">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource ButtonBgBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="7,3"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!-- 当前色块：绑 UserControl 的 Hex，经转换器取刷子。
                                     扁宽块（20x14）与勾选框的 16x16 方框拉开造型差异，避免被误读成复选框 -->
                                <Border Width="20" Height="14" CornerRadius="3"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Background="{Binding Hex, RelativeSource={RelativeSource AncestorType=local:ColorChipButton},
                                                    Converter={StaticResource HexToBrush}}"/>
                                <!-- 标签文字跟随主题正文色（不设会沿窗口默认黑色，深色/高对比主题下黑上黑不可读） -->
                                <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:ColorChipButton}}"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 右端当前色值（ShowHex 开启时显示）：按钮等宽拉伸的布局里填充右侧视觉重心 -->
                            <TextBlock Text="{Binding Hex, RelativeSource={RelativeSource AncestorType=local:ColorChipButton}}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding ShowHex, RelativeSource={RelativeSource AncestorType=local:ColorChipButton},
                                                   Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- 调色板弹层：StaysOpen=False 点外部即关。悬浮样式（与按钮留间距 + 四边完整圆角边框）：
             明确读作独立浮层，不与接收区框体视觉粘连（贴边"下拉式"样式曾被误读为框体变形）。
             Focusable=True：内含自定义色输入框（HEX/RGB），需要能接受键入焦点 -->
        <Popup x:Name="PalettePopup" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
               AllowsTransparency="True" PopupAnimation="Fade" Focusable="True" Opened="PalettePopup_Opened">
            <Border CornerRadius="4" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,4,0,4" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="8" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel Margin="6">
                    <!-- 色图：横轴饱和度（白→当前色相纯色）、纵轴明度（透明→黑），两层渐变叠出 HSV 的 S/V 平面；
                         十字圈拖动取色。拖动中只刷预览与输入框，松手才写回 Hex
                         （松手提交避免拖动期间每秒数十次全量重绘 + 落盘 ui_settings.json） -->
                    <Grid x:Name="ColorMap" Height="140" MinWidth="200" Cursor="Cross"
                          MouseLeftButtonDown="Map_MouseDown" MouseMove="Map_MouseMove" MouseLeftButtonUp="Map_MouseUp">
                        <Rectangle RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop x:Name="HueStop" Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle RadiusX="4" RadiusY="4" Stroke="{DynamicResource ControlBorderBrush}"
                                   StrokeThickness="1" SnapsToDevicePixels="True"/>
                        <Canvas IsHitTestVisible="False">
                            <!-- 十字圈：白描边 + 投影，色图亮区/暗区都看得见 -->
                            <Ellipse x:Name="MapThumb" Width="12" Height="12" Fill="#FF0000"
                                     Stroke="#FFFFFF" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="3" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <!-- 色相条：虹彩渐变 + 竖标拖动定色相，色图右端纯色随之换 -->
                    <Grid x:Name="HueBar" Height="12" Margin="0,6,0,0" Cursor="Hand"
                          MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Hue_MouseUp">
                        <Rectangle RadiusX="6" RadiusY="6">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="HueThumb" Width="6" Height="16" Canvas.Left="0" Canvas.Top="-2"
                                    CornerRadius="2" Background="#FFFFFF"
                                    BorderBrush="#3C3C3C" BorderThickness="1"/>
                        </Canvas>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,6"/>
                    <ItemsControl ItemsSource="{x:Static local:ColorChipButton.Palette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 局部覆盖全局按钮样式（MinWidth=64/Padding=12,4 会撑爆小色块） -->
                                <Button Width="20" Height="20" MinWidth="0" MinHeight="0"
                                        Padding="0" Margin="1" Cursor="Hand"
                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                        ToolTip="{Binding}"
                                        CommandParameter="{Binding}" Click="Swatch_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 自定义色：HEX（RRGGBB）与 RGB（0-255）双向联动，应用即写回 Hex 实时生效 -->
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="1,0">
                        <Border x:Name="PreviewBox" Width="20" Height="20" CornerRadius="3"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                ToolTip="自定义色预览"/>
                        <TextBlock Text="#" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        <TextBox x:Name="HexBox" Width="62" MinHeight="0" Padding="4,2"
                                 FontFamily="{DynamicResource MonoFont}" MaxLength="7"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="十六进制色值（RRGGBB，如 FF8800），Enter 应用"
                                 TextChanged="HexBox_TextChanged" PreviewKeyDown="HexBox_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="1,6,1,0">
                        <TextBlock Text="R" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="RBox" Width="34" MinHeight="0" Padding="2,2" Margin="2,0,6,0"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="0-255" TextChanged="RgbBox_TextChanged"/>
                        <TextBlock Text="G" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="GBox" Width="34" MinHeight="0" Padding="2,2" Margin="2,0,6,0"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="0-255" TextChanged="RgbBox_TextChanged"/>
                        <TextBlock Text="B" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="BBox" Width="34" MinHeight="0" Padding="2,2" Margin="2,0,6,0"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="0-255" TextChanged="RgbBox_TextChanged"/>
                        <Button Content="应用" MinWidth="0" Padding="8,2" VerticalAlignment="Center"
                                ToolTip="应用自定义色（保持弹层打开，可继续微调）" Click="ApplyCustom_Click"/>
                    </StackPanel>
                    <Button Content="恢复默认" MinWidth="0" Margin="0,6,0,0" Click="Reset_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
