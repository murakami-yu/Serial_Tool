<UserControl x:Class="SerialTool.App.Controls.ColorChipButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SerialTool.App.Controls">
    <!-- 颜色选择控件：色块按钮 + 预设调色板弹层（视觉语言照抄全局按钮/下拉框模板） -->
    <Grid>
        <ToggleButton x:Name="Toggle" Cursor="Hand" VerticalAlignment="Center">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource ButtonBgBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="7,3"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <!-- 当前色块：绑 UserControl 的 Hex，经转换器取刷子 -->
                            <Border Width="14" Height="14" CornerRadius="3"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                    Background="{Binding Hex, RelativeSource={RelativeSource AncestorType=local:ColorChipButton},
                                                Converter={StaticResource HexToBrush}}"/>
                            <!-- 标签文字跟随主题正文色（不设会沿窗口默认黑色，深色/高对比主题下黑上黑不可读） -->
                            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:ColorChipButton}}"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- 调色板弹层：StaysOpen=False 点外部即关。悬浮样式（与按钮留间距 + 四边完整圆角边框）：
             明确读作独立浮层，不与接收区框体视觉粘连（贴边"下拉式"样式曾被误读为框体变形）。
             Focusable=True：内含自定义色输入框（HEX/RGB），需要能接受键入焦点 -->
        <Popup x:Name="PalettePopup" IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
               AllowsTransparency="True" PopupAnimation="Fade" Focusable="True" Opened="PalettePopup_Opened">
            <Border CornerRadius="4" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,4,0,4" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="8" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel Margin="6">
                    <ItemsControl ItemsSource="{x:Static local:ColorChipButton.Palette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 局部覆盖全局按钮样式（MinWidth=64/Padding=12,4 会撑爆小色块） -->
                                <Button Width="20" Height="20" MinWidth="0" MinHeight="0"
                                        Padding="0" Margin="1" Cursor="Hand"
                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                        ToolTip="{Binding}"
                                        CommandParameter="{Binding}" Click="Swatch_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 自定义色：HEX（RRGGBB）与 RGB（0-255）双向联动，应用即写回 Hex 实时生效 -->
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="1,0">
                        <Border x:Name="PreviewBox" Width="20" Height="20" CornerRadius="3"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                ToolTip="自定义色预览"/>
                        <TextBlock Text="#" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        <TextBox x:Name="HexBox" Width="62" MinHeight="0" Padding="4,2"
                                 FontFamily="Cascadia Mono, Consolas" MaxLength="7"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="十六进制色值（RRGGBB，如 FF8800），Enter 应用"
                                 TextChanged="HexBox_TextChanged" PreviewKeyDown="HexBox_KeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="1,6,1,0">
                        <TextBlock Text="R" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="RBox" Width="34" MinHeight="0" Padding="2,2" Margin="2,0,6,0"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="0-255" TextChanged="RgbBox_TextChanged"/>
                        <TextBlock Text="G" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="GBox" Width="34" MinHeight="0" Padding="2,2" Margin="2,0,6,0"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="0-255" TextChanged="RgbBox_TextChanged"/>
                        <TextBlock Text="B" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="BBox" Width="34" MinHeight="0" Padding="2,2" Margin="2,0,6,0"
                                 InputMethod.IsInputMethodEnabled="False"
                                 ToolTip="0-255" TextChanged="RgbBox_TextChanged"/>
                        <Button Content="应用" MinWidth="0" Padding="8,2" VerticalAlignment="Center"
                                ToolTip="应用自定义色（保持弹层打开，可继续微调）" Click="ApplyCustom_Click"/>
                    </StackPanel>
                    <Button Content="恢复默认" MinWidth="0" Margin="0,6,0,0" Click="Reset_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
