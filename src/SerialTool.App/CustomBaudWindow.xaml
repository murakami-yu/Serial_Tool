<Window x:Class="SerialTool.App.CustomBaudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义波特率" SizeToContent="WidthAndHeight"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16" Width="260">
        <TextBlock Text="波特率（正整数，如 748800）：" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="Input" Margin="0,6,0,0"/>
        <TextBlock x:Name="Err" Foreground="#C00000" Margin="0,4,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" IsDefault="True" Click="OnOk" Width="70"/>
            <Button Content="取消" IsCancel="True" Margin="8,0,0,0" Width="70"/>
        </StackPanel>
    </StackPanel>
</Window>
